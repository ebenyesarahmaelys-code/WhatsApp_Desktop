<Window x:Class="P2P.App.Views.AddPeerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un pair"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="28">
        <TextBlock Text="Ajouter un pair" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Si le pair n'apparaît pas automatiquement, saisis son adresse IP et son port."
                   Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,18" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Adresse IP" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="IpBox" Style="{StaticResource RoundedTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PortBox" Style="{StaticResource RoundedTextBox}" Text="5000" MaxLength="5" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="#B3261E" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />

        <TextBlock x:Name="RecentLabel" Text="RÉCEMMENT VUS" Style="{StaticResource SectionLabel}" Margin="0,10,0,8" />
        <ListBox x:Name="RecentList" BorderThickness="0" MaxHeight="150" SelectionChanged="OnRecentSelected">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="4,6" Width="380">
                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="13">
                            <Run Text="{Binding Ip, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Pseudo}" FontWeight="Medium" FontSize="14" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Height="44" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Se connecter" Style="{StaticResource PrimaryButton}" Height="44" IsDefault="True" Click="OnConnectClick" />
        </StackPanel>
    </StackPanel>
</Window>
