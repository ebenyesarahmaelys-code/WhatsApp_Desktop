<Window x:Class="P2P.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1280" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== COLONNE GAUCHE : CONTACTS ===================== -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="White">
            <DockPanel>
                <!-- Mon profil -->
                <Border DockPanel.Dock="Top" Height="64" Background="{StaticResource PanelBrush}" Padding="16,0">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="＋" ToolTip="Ajouter un pair par IP" Click="OnAddPeerClick" />
                            <Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="Paramètres" Click="OnSettingsClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimaryBrush}">
                                <TextBlock Text="{Binding MyInitials}" Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Me.Pseudo}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding MyInfo}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Recherche -->
                <Grid DockPanel.Dock="Top" Margin="12,10">
                    <TextBox x:Name="SearchBox" Style="{StaticResource RoundedTextBox}" Height="38" FontSize="14"
                             Background="{StaticResource InputBrush}" BorderThickness="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Rechercher un pair…" Foreground="#6B7570" FontSize="14" Margin="16,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="PAIRS DÉTECTÉS SUR LE RÉSEAU" Style="{StaticResource SectionLabel}" Margin="16,4,16,6" />

                <!-- Liste des pairs -->
                <ListBox ItemsSource="{Binding PeersView}" SelectedItem="{Binding SelectedPeer}"
                         BorderThickness="0" ItemContainerStyle="{StaticResource PeerItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Avatar + point en ligne -->
                                <Grid Width="46" Height="46" VerticalAlignment="Center">
                                    <Border CornerRadius="23" Background="{Binding AvatarBrush}">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Ellipse Width="13" Height="13" Stroke="White" StrokeThickness="2"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource OfflineBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastTime}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding Pseudo}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3,0,0">
                                        <Border DockPanel.Dock="Right" MinWidth="20" Height="20" CornerRadius="10" Padding="6,0"
                                                Background="{StaticResource AccentBrush}" Margin="8,0,0,0"
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding LastMessage}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding OnlineText}" FontSize="11" Foreground="#6B7570" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== COLONNE DROITE : CONVERSATION ===================== -->
        <Grid Grid.Column="1">

            <!-- Écran vide (aucun contact sélectionné) -->
            <Border Background="{StaticResource PanelBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedPeer}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="💬" FontSize="64" HorizontalAlignment="Center" />
                    <TextBlock Text="WhatsApp Desktop P2P" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,8" />
                    <TextBlock Text="Sélectionne un contact à gauche pour commencer à discuter." Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Text="Les messages passent directement de PC à PC, sans serveur." Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Conversation -->
            <DockPanel Visibility="{Binding HasSelectedPeer, Converter={StaticResource BoolToVisibility}}">

                <!-- En-tête du contact -->
                <Border DockPanel.Dock="Top" Height="64" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="📞" ToolTip="Appel audio" Click="OnCallClick" />
                            <Button Style="{StaticResource IconButton}" Content="🎥" ToolTip="Appel vidéo" Click="OnCallClick" />
                            <Button Style="{StaticResource IconButton}" Content="📎" ToolTip="Envoyer un fichier" Command="{Binding SendFileCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{Binding SelectedPeer.AvatarBrush}">
                                <TextBlock Text="{Binding SelectedPeer.Initials}" Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPeer.Pseudo}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding SelectedPeer.OnlineText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Zone de saisie -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="16,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SendButton}" Content="➤" FontSize="18"
                                Margin="10,0,0,0" Command="{Binding SendCommand}" ToolTip="Envoyer (Entrée)" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="📎" Margin="0,0,8,0"
                                Command="{Binding SendFileCommand}" ToolTip="Joindre un fichier" />
                        <Grid>
                            <TextBox x:Name="MessageInput" Style="{StaticResource RoundedTextBox}" BorderThickness="0" FontSize="14"
                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Écrire un message…" Foreground="#6B7570" FontSize="14" Margin="14,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=MessageInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Messages -->
                <ScrollViewer x:Name="MessagesScroll" Background="{StaticResource ChatBackgroundBrush}"
                              VerticalScrollBarVisibility="Auto" Padding="56,16">
                    <ItemsControl ItemsSource="{Binding SelectedPeer.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MaxWidth="520" Margin="0,4" Padding="12,8,12,6" CornerRadius="10"
                                        MouseLeftButtonDown="OnMessageClick">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.12" />
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Background" Value="{StaticResource OtherBubbleBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Background" Value="{StaticResource MyBubbleBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <!-- Bloc fichier -->
                                        <Border Background="#1A0F6E56" CornerRadius="8" Padding="10" Width="300" Margin="0,0,0,4"
                                                Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="40" Height="48" CornerRadius="6" Background="#C0392B" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FileExtension}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Height="6" Margin="0,5" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                                 Foreground="{StaticResource PrimaryBrush}" Background="#A8D8BF" BorderThickness="0"
                                                                 Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding FileInfo}" FontSize="11" Foreground="#3A4540" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Texte -->
                                        <TextBlock Text="{Binding Content}" FontSize="14" TextWrapping="Wrap" LineHeight="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Heure + statut -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding StateIcon}" FontSize="11" Margin="4,0,0,0" Foreground="#2F7FD1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
