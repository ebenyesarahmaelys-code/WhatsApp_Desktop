<Window x:Class="P2P.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhatsApp P2P — Connexion"
        Width="900" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Panneau gauche (présentation) ===== -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}" Padding="40,48">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="✓  Découverte automatique (UDP)" Foreground="#CFE5DC" FontSize="13" Margin="0,0,0,10" />
                    <TextBlock Text="✓  Messages et fichiers en TCP direct" Foreground="#CFE5DC" FontSize="13" Margin="0,0,0,10" />
                    <TextBlock Text="✓  Historique local (SQLite)" Foreground="#CFE5DC" FontSize="13" />
                </StackPanel>
                <StackPanel>
                    <Border Width="60" Height="60" CornerRadius="16" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="💬" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="WhatsApp&#x0a;Desktop P2P" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,18,0,0" />
                    <TextBlock Foreground="#CFE5DC" FontSize="15" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="24"
                               Text="Messagerie pair-à-pair sur réseau local : pas de serveur central, chaque poste est à la fois client et serveur." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Formulaire ===== -->
        <StackPanel Grid.Column="1" Margin="48,56">
            <TextBlock Text="Bienvenue" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Choisis ton pseudo pour être visible des autres pairs." Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,6,0,24" />

            <TextBlock Text="Pseudo" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="PseudoBox" Style="{StaticResource RoundedTextBox}" MaxLength="30" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Mon adresse IP" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="IpBox" Style="{StaticResource RoundedTextBox}" IsReadOnly="True" Foreground="#3A4540" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Port d'écoute TCP" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PortBox" Style="{StaticResource RoundedTextBox}" Text="5000" MaxLength="5" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="VisibleCheck" IsChecked="True" Margin="0,20,0,0" FontSize="14"
                      Content="Me rendre visible sur le réseau local" VerticalContentAlignment="Center" />

            <Button Content="Démarrer" Style="{StaticResource PrimaryButton}" Margin="0,28,0,0"
                    IsDefault="True" Click="OnStartClick" />

            <TextBlock x:Name="ErrorText" Foreground="#B3261E" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Text="Le pare-feu Windows peut demander d'autoriser l'application au premier lancement."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Window>
